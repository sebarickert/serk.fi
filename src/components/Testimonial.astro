---
import type { AstroComponentFactory } from "astro/runtime/server/render/astro/index.js";
import type { CollectionEntry } from "astro:content";

interface Props extends CollectionEntry<"testimonials"> {
  Content: AstroComponentFactory;
  class?: string;
}

const {
  data: { role },
  class: classes,
  Content,
} = Astro.props;
---

<div class:list={["grid gap-2", classes]}>
  <div class="text-prominent font-semibold text-pretty">
    <Content />
  </div>
  <p class="text-pretty">
    —
    {role}
  </p>
</div>
